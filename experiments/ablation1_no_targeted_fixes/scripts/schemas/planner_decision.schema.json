{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Planner Decision",
  "description": "Output contract for the Planner agent. Commits to 1–7 execution plans of type 'sequence' or 'staged'. Analysis is done internally — only the decision, rationale, and plans are written.",
  "type": "object",
  "required": ["decision", "rationale", "plan_count", "plans"],

  "properties": {

    "decision": {
      "type": "string",
      "enum": ["execute"],
      "description": "Always 'execute' — the Planner always commits to plans."
    },

    "rationale": {
      "type": "array",
      "description": "2–4 bullet points connecting key analysis conclusions to the plan choices. For N≥2, include convergence assessment.",
      "items": { "type": "string" },
      "minItems": 1
    },

    "plan_count": {
      "type": "integer",
      "minimum": 1,
      "maximum": 7,
      "description": "Number of plans in the 'plans' array. Must equal plans.length."
    },

    "plans": {
      "type": "array",
      "minItems": 1,
      "maxItems": 7,
      "items": {
        "oneOf": [
          {
            "title": "Sequence Plan",
            "type": "object",
            "required": ["plan_type", "sequence", "reasoning", "expected_outcome"],
            "properties": {
              "plan_type": { "type": "string", "const": "sequence" },
              "sequence": {
                "type": "array",
                "items": { "type": "string", "enum": ["sizeup", "sizedown", "vt_swap", "buffer", "split", "unbuffer", "clone", "sizeup_match", "swap"] },
                "minItems": 1, "maxItems": 9, "uniqueItems": true
              },
              "run_knobs": {
                "type": "object",
                "properties": {
                  "repair_tns":           { "type": "number",  "minimum": 0, "maximum": 100 },
                  "max_passes":           { "type": "integer", "minimum": 1 },
                  "max_iterations":       { "type": "integer", "minimum": 1 },
                  "setup_margin":         { "type": "number" },
                  "skip_last_gasp":       { "type": "boolean" },
                  "skip_crit_vt_swap":    { "type": "boolean" }
                },
                "additionalProperties": false
              },
              "reasoning":        { "type": "array", "items": { "type": "string" }, "minItems": 1 },
              "expected_outcome": { "type": "string" }
            },
            "additionalProperties": false
          },
          {
            "title": "Staged Plan",
            "type": "object",
            "required": ["plan_type", "stages", "reasoning", "expected_outcome"],
            "properties": {
              "plan_type": { "type": "string", "const": "staged" },
              "stages": {
                "type": "array",
                "minItems": 2, "maxItems": 9,
                "items": {
                  "type": "object",
                  "required": ["move"],
                  "properties": {
                    "label": { "type": "string" },
                    "move":  { "type": "string", "enum": ["sizeup", "sizedown", "vt_swap", "buffer", "split", "unbuffer", "clone", "sizeup_match", "swap"] },
                    "run_knobs": {
                      "type": "object",
                      "properties": {
                        "repair_tns":           { "type": "number",  "minimum": 0, "maximum": 100 },
                        "max_passes":           { "type": "integer", "minimum": 1 },
                        "max_iterations":       { "type": "integer", "minimum": 1 },
                        "setup_margin":         { "type": "number" },
                        "skip_last_gasp":       { "type": "boolean" },
                        "skip_crit_vt_swap":    { "type": "boolean" }
                      },
                      "additionalProperties": false
                    }
                  },
                  "additionalProperties": false
                }
              },
              "reasoning":        { "type": "array", "items": { "type": "string" }, "minItems": 1 },
              "expected_outcome": { "type": "string" }
            },
            "additionalProperties": false
          }
        ]
      }
    },

    "more_info": {
      "type": "string",
      "description": "1-2 sentences: what additional data or context would have helped you make a better plan? Not parsed by infrastructure — for human review only."
    }
  },

  "additionalProperties": false
}
